FLASK_ENV=development
FLASK_PORT=8000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=biometric_attendance
DB_USER=root
DB_PASSWORD=

# face_recognition (dlib) threshold
# Reference code uses 0.6 — we use 0.55 for stricter matching
# Genuine pairs typically < 0.4, impostors > 0.6
RECOGNITION_THRESHOLD=0.55
VERIFICATION_THRESHOLD=0.50

# Multi-frame confirmation frames required
CONFIRMATION_FRAMES=3

# Image settings
MAX_IMAGE_SIZE_MB=5
